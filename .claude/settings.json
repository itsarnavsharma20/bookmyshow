{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash",
      "PowerShell",
      "Write",
      "Edit",
      "NotebookEdit",
      "WebFetch"
    ],
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git clone*)",
      "Bash(git init*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git rm*)",
      "Bash(git clean*)",
      "Bash(git tag*)",
      "Bash(git remote*)",
      "Bash(git config*)",
      "Bash(gh *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/session-start.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/approve.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/guard.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
